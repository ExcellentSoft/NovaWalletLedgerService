{
  "ConnectionStrings": {
    "NovaWalletDb": "Host=localhost;Port=5432;Database=novawallet;Username=postgres;Password=postgres"
  },
  "Wallet": {
    "DailyOutboundTransferLimitKobo": 50000000
  },
  "Jwt": {
    "Issuer": "NovaWallet.MockIssuer",
    "Audience": "NovaWallet.API",
    "SigningKey": "novawallet-dev-signing-key-change-me-32chars",
    "ExpiryMinutes": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
